# === Teams（ブラウザ自動ログイン方式） ===
# 使用ブラウザ: msedge（標準の Microsoft Edge を使用）| bundled（Playwright 同梱 Chromium）
TEAMS_BROWSER=msedge
# 1 = ヘッドレス（画面を出さない）/ 0 = 画面あり。ログインが通らない時は 0 に
TEAMS_HEADLESS=1
# 対象を絞りたい場合のみ（部分一致・カンマ区切り）。空 = すべてのチーム/チャネル
# TEAMS_ONLY=1年1組,数学
# CHANNEL_ONLY=一般,お知らせ

# === Google（Cloud コンソール / デスクトップアプリ OAuth） ===
# README の手順 4 で取得して記入する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === カレンダー ===
# 同期先カレンダー。既定は primary（メインカレンダー）。
CALENDAR_ID=primary

# 何日前までの投稿ファイルを対象にするか（既定 7）
LOOKBACK_DAYS=7
# 予定の長さ（分、既定 30）
EVENT_DURATION_MINUTES=30
# 締切に時刻が書かれていない場合の既定時刻（既定 23:59）
DEFAULT_DEADLINE_TIME=23:59
# リマインダー（分、カンマ区切り。既定 = 24時間前 と 1時間前）
REMINDER_MINUTES=1440,60
